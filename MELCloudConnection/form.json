{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "Email",
            "caption": "E-Mail (MELCloud Home)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Passwort"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Status-Aktualisierung (Sekunden, min. 10)",
            "minimum": 10,
            "suffix": "s"
        },
        {
            "type": "NumberSpinner",
            "name": "EnergyInterval",
            "caption": "Energie-Aktualisierung (Minuten)",
            "minimum": 5,
            "suffix": "min"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Login testen",
            "onClick": "MELC_TestLogin($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Verbunden"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Zugangsdaten fehlen"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Verbindungs-/Anmeldefehler"
        }
    ]
}
